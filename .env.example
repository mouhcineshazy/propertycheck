# ============================================================
# PropertyCheck — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is exposed to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Price IDs from your Stripe product catalog (web subscription only)
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=price_...
# One-time products (pay-per-report, moving bundle) are sold via native IAP /
# RevenueCat on mobile — see EXPO_PUBLIC_REVENUECAT_* keys, not Stripe.

# --- RevenueCat (mobile IAP) — apps/mobile/.env ---
# Public SDK keys (safe to ship; they only identify the project). App-specific
# keys are appl_… (iOS) / goog_… (Android); a test_… Test Store key works
# cross-platform for sandbox testing (use the same value for both).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Server-only (Supabase Edge Function secret, NEVER EXPO_PUBLIC_): the shared
# secret the revenuecat-webhook checks on incoming events.
REVENUECAT_WEBHOOK_AUTH=...

# --- Email (Resend) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender address (must be on a domain you own in Resend)
FROM_EMAIL=noreply@propertycheck.app

# --- App ---
# Public URL used for share links, email links, and OAuth redirects
NEXT_PUBLIC_APP_URL=https://propertycheck.app
