# ============================================================
# PropertyCheck — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Stripe ---
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is exposed to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Price IDs from your Stripe product catalog
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=price_...
# One-time pay-per-report unlock ($5.99 CAD) — create in Stripe Dashboard → Products
NEXT_PUBLIC_STRIPE_REPORT_PRICE_ID=price_...
# One-time moving bundle ($19.99 CAD) — move-in + move-out + comparison, 18-month validity
NEXT_PUBLIC_STRIPE_BUNDLE_PRICE_ID=price_...

# --- Email (Resend) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_...
# Verified sender address (must be on a domain you own in Resend)
FROM_EMAIL=noreply@propertycheck.app

# --- App ---
# Public URL used for share links, email links, and OAuth redirects
NEXT_PUBLIC_APP_URL=https://propertycheck.app
